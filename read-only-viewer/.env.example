# Sybil's Alcove — read-only viewer. Copy to .env (or an EnvironmentFile) and edit.
# Every value has a working default; nothing here is required for a local run.

# Where to listen. Localhost needs no token; see ALCOVE_TOKEN before widening.
ALCOVE_PORT=8899
ALCOVE_BIND=127.0.0.1

# Shared secret. REQUIRED for any non-loopback bind — the server refuses to start
# on a wider bind without one, because this page displays task prompts and a
# private network is not authentication.
# Generate:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Browsers POST it to /login and get an HttpOnly cookie; scripts send
# `Authorization: Bearer <token>`. There is deliberately no ?token= parameter.
# Keep this file out of git and mode 0600 — it holds a live credential.
ALCOVE_TOKEN=

# Seconds without a transcript write before a session with no owning process is
# treated as idle rather than writing. Does not affect `running`, which comes
# from the process list.
ALCOVE_LIVE_WINDOW_S=300

# Transcripts reach 100MB+, so only the tail is parsed: token and turn totals are
# recent-window, not lifetime. Identity is read from the head, so no session is
# missed. Raise for longer history at the cost of read time.
ALCOVE_TAIL_LINES=4000
ALCOVE_TAIL_BYTES=1048576

# Transcript roots.
ALCOVE_CLAUDE_ROOT=~/.claude/projects
ALCOVE_CODEX_ROOT=~/.codex/sessions

# Path to the `claude` CLI, which supplies the authoritative session-id -> pid
# mapping. Auto-resolved via PATH then nvm; set it explicitly when running under
# a service manager, whose PATH usually has no nvm directory.
ALCOVE_CLAUDE_BIN=

# Where the derived-fact store lives (stdlib sqlite; no dependency).
# Default: $XDG_STATE_HOME/alcove/alcove.db, i.e. ~/.local/state/alcove/alcove.db
# Populate it with:  python3 alcove.py --ingest-only   (idempotent, cron-safe)
ALCOVE_DB=
