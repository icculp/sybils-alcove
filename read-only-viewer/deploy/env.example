# Copy to /etc/alcove/env, chmod 600. Never commit the filled-in file.
#
# ALCOVE_TOKEN is mandatory for any non-loopback bind: the server refuses to
# start without one. On a loopback bind auth is skipped and the startup banner
# says so — read the banner, do not assume.
ALCOVE_TOKEN=

# Default 127.0.0.1. Widening this publishes every transcript on the machine to
# anyone who can reach the address, so it is a deliberate per-host decision. A
# private overlay is not authentication; the token is.
ALCOVE_BIND=127.0.0.1
ALCOVE_PORT=8899

# Optional. Defaults shown.
#ALCOVE_CLAUDE_ROOT=~/.claude/projects
#ALCOVE_CODEX_ROOT=~/.codex/sessions
#ALCOVE_LIVE_WINDOW_S=300
#ALCOVE_CACHE_TTL_S=2
#ALCOVE_PID_TTL_S=15
